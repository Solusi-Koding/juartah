{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "juartah-upload",
  "account_id": "b0a62759a61b3e4dc25c7d83ad85e223",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [{ "pattern": "juartah.my.id", "custom_domain": true }],
  "vars": { "APP_URL": "https://juartah.my.id" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "juartah-upload",
      "database_id": "5138355a-5e6a-439f-8786-3b28438b2233",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RL_START", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_STATUS", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ]
  // Tanpa cron: akun gratis sudah memakai 5 cron. Perawatan berkala jalan dari permintaan masuk (lihat src/worker/index.ts).
  // Kalau akun di-upgrade ke Workers Paid, boleh tambahkan lagi: "triggers": { "crons": ["17 * * * *"] }
}
